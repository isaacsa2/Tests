{
  "name": "tests",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": [
    "allow_custom_ports"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "FSA_SIU_CITY": "null"
  },
  "d1_databases": [
    {
      "binding": "FEIRABUS_DB",
      "database_name": "db_app",
      "database_id": "fef5837c-0c0f-4c63-b625-55c85303999b",
      "migrations_dir": "migrations"
    }
  ]
}
